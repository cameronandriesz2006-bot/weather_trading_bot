# Trading Bot Configuration
# Copy this to .env and fill in values

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./tradingbot.db
# DATABASE_URL=postgresql://user:pass@localhost/tradingbot

# Simulation settings
SIMULATION_MODE=true
INITIAL_BANKROLL=10000
KELLY_FRACTION=0.05
MIN_EDGE_THRESHOLD=0.08

# Kalshi API (RSA key auth for weather markets)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_ENABLED=true
FRED_API_KEY=
BLS_API_KEY=

# Mapbox token for map visualization (optional - demo token works)
VITE_MAPBOX_TOKEN=

# Polymarket CLOB execution (Tier C, 2026-08-05). Unset on this box by design: everything
# except the authenticated POST path is built and tested without a key. Set all three or none
# -- backend/exec refuses to start on a partial set and names the missing vars.
# Polygon EOA private key that SIGNS orders (0x + 64 hex). Never commit it; never log it.
POLYMARKET_PRIVATE_KEY=
# Address that HOLDS the USDC. Equals the signer for signature type 0; for 1/2 it is the
# Polymarket proxy/safe address, which is NOT the signer's address.
POLYMARKET_FUNDER_ADDRESS=
# How the order is signed: 0=EOA, 1=email/magic proxy, 2=browser-wallet (Gnosis safe) proxy.
POLYMARKET_SIGNATURE_TYPE=
