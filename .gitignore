# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/
*.egg-info/
/dist/
build/
*.egg

# Database
*.db
*.sqlite3

# Pre-reset DB archives (server-local runtime data; the .db can't travel via git
# anyway, and the README only makes sense next to it — keep the whole dir local)
# (glob the CONTENTS, not the dir — git won't descend into an excluded directory,
#  so `archive/` would make the negation below unreachable.)
archive/*
# ...but archive/weather-bot/ is retired SOURCE and DOCS, which must travel.
!archive/weather-bot/
# Except its runtime log blob (11MB of fillability-probe output, server-local).
archive/weather-bot/logs/

# Environment
.env
.env.local
.env.*.local

# Cached CLOB L2 API creds (derived once from the private key; the secret is an order-
# placement credential and cannot be re-fetched from the server). Local, 0600, never travels.
.clob_creds.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build
# NOTE: frontend/dist is intentionally TRACKED (committed) so a plain `git pull` serves
# the updated dashboard with NO build step. Rebuild (npm run build) + commit dist after
# any frontend source change, or the committed bundle goes stale.
frontend/build/

# Logs
*.log
logs/

# Cache
.cache/
*.cache

# Test
.coverage
htmlcov/
.pytest_cache/
*.pem
backend/data/backtest_cache/

# Calibration cache (regenerable via backend.data.calibration_cache)
backend/data/calibration_cache.json
